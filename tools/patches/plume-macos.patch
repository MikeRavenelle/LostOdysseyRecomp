+    // LostOdysseyRecomp: SPIR-V input. The options mirror examples/cmake/tools/
+    // spirv_cross_msl.cpp, which defines the binding model this backend expects:
+    // descriptor set N as argument buffer N, push constants at buffer(8)
+    // (PUSH_CONSTANTS_BINDING_INDEX), and contiguous argument buffer ids.
+    static std::string PadDescriptorSets(const std::string &source) {
+        std::stringstream result;
+        std::istringstream lines(source);
+        std::string line;
+        bool insideSet = false;
+        int currentId = 0;
+        while (std::getline(lines, line)) {
+            if (line.find("struct spvDescriptorSetBuffer") != std::string::npos) {
+                insideSet = true;
+                currentId = 0;
+                result << line << '\n';
+                if (std::getline(lines, line))
+                    result << line << '\n'; // opening brace
+                continue;
+            }
+            if (insideSet) {
+                if (line == "};") {
+                    insideSet = false;
+                } else {
+                    const size_t start = line.find("[[id(");
+                    if (start != std::string::npos) {
+                        const int lineId = std::atoi(line.c_str() + start + 5);
+                        for (; currentId < lineId; currentId++)
+                            result << "\tconstant float* _PadResource" << currentId << " [[id(" << currentId << ")]];\n";
+                        currentId++;
+                    }
+                }
+            }
+            result << line << '\n';
+        }
+        return result.str();
+    }
+
+    static bool TranslateSpirvToMsl(const void *data, uint64_t size, const char *entryPointName, std::string &source, std::string &functionName, bool &writesPointSize) {
+        if ((size % sizeof(uint32_t)) != 0) {
+            fprintf(stderr, "SPIR-V size %llu is not a whole number of words.\n", (unsigned long long)size);
+            return false;
+        }
+        try {
+            const auto *words = static_cast<const uint32_t *>(data);
+            spirv_cross::Parser parser(std::vector<uint32_t>(words, words + size / sizeof(uint32_t)));
+            parser.parse();
+            spirv_cross::CompilerMSL msl(std::move(parser.get_parsed_ir()));
+
+            spv::ExecutionModel model = spv::ExecutionModelMax;
+            std::string entryName;
+            const std::string requested = entryPointName != nullptr ? entryPointName : "";
+            for (const auto &entry : msl.get_entry_points_and_stages()) {
+                if (requested.empty() || entry.name == requested) {
+                    model = entry.execution_model;
+                    entryName = entry.name;
+                    msl.set_entry_point(entryName, model);
+                    break;
+                }
+            }
+            if (model == spv::ExecutionModelMax) {
+                fprintf(stderr, "SPIR-V has no entry point named '%s'.\n", requested.c_str());
+                return false;
+            }
+
+            spirv_cross::CompilerMSL::Options mslOptions;
+            // 2.3, not the reference 2.1: the runtime's SPIR-V reads 64-bit
+            // device addresses, which MSL supports from 2.3.
+            mslOptions.msl_version = spirv_cross::CompilerMSL::Options::make_msl_version(2, 3);
+            mslOptions.argument_buffers = true;
+            mslOptions.texture_buffer_native = true;
+            mslOptions.enable_decoration_binding = true;
+            msl.set_msl_options(mslOptions);
+
+            for (const spv::ExecutionModel stage : { spv::ExecutionModelVertex, spv::ExecutionModelFragment, spv::ExecutionModelGLCompute }) {
+                spirv_cross::MSLResourceBinding binding;
+                binding.stage = stage;
+                binding.desc_set = spirv_cross::kPushConstDescSet;
+                binding.binding = spirv_cross::kPushConstBinding;
+                binding.msl_buffer = PUSH_CONSTANTS_BINDING_INDEX;
+                msl.add_msl_resource_binding(binding);
+            }
+
+            spirv_cross::CompilerGLSL::Options commonOptions;
+            commonOptions.vertex.flip_vert_y = true;
+            msl.set_common_options(commonOptions);
+
+            source = PadDescriptorSets(msl.compile());
+            functionName = msl.get_cleansed_entry_point_name(entryName, model);
+            writesPointSize = source.find("[[point_size]]") != std::string::npos;
+            return true;
+        }
+        catch (const std::exception &e) {
+            fprintf(stderr, "SPIR-V to MSL translation failed: %s\n", e.what());
+            return false;
+        }
+    }
